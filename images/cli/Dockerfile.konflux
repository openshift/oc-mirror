# Dockerfile for the Konflux CDN release pipeline: builds oc-mirror binaries for the
# native architecture of the build worker on RHEL 8/9, packages them as compressed
# tarballs in /releases/ for push-artifacts-to-cdn.
#
# Each build produces two archives for its own architecture, named with the Go
# architecture name (for example amd64 or s390x):
#   /releases/oc-mirror-rhel8-linux-<arch>.tar.gz
#   /releases/oc-mirror-rhel9-linux-<arch>.tar.gz
# The release pipeline is expected to run this build on a worker of each supported
# architecture and collect the archives from all of them.
#
# The binaries (v2 and the embedded v1) are built with CGO_ENABLED=1 and
# GOEXPERIMENT=strictfipsruntime so they use the Red Hat Go toolchain's OpenSSL-based
# FIPS backend. GOTOOLCHAIN=local keeps the builder's Red Hat toolchain instead of
# downloading a different Go toolchain. This recipe requires a native worker: each
# stage fails before building if GOARCH differs from the worker's native architecture.

# Stage 1: Build RHEL 8 binaries for the native architecture
FROM registry.access.redhat.com/ubi8/go-toolset:1.26 AS builder_rhel8
USER root
WORKDIR /go/src/github.com/openshift/oc-mirror
COPY . .
RUN git config --global --add safe.directory /go/src/github.com/openshift/oc-mirror && \
    arch="$(go env GOARCH)" && \
    if [ "${arch}" != "$(go env GOHOSTARCH)" ]; then \
      echo "native build required: GOARCH=${arch} differs from GOHOSTARCH=$(go env GOHOSTARCH)" >&2; exit 1; \
    fi && \
    CGO_ENABLED=1 GOEXPERIMENT=strictfipsruntime GOTOOLCHAIN=local make build && \
    mkdir -p /output && \
    tar -czf "/output/oc-mirror-rhel8-linux-${arch}.tar.gz" -C bin oc-mirror

# Stage 2: Build RHEL 9 binaries for the native architecture
FROM registry.access.redhat.com/ubi9/go-toolset:1.26 AS builder_rhel9
USER root
WORKDIR /go/src/github.com/openshift/oc-mirror
COPY . .
RUN git config --global --add safe.directory /go/src/github.com/openshift/oc-mirror && \
    arch="$(go env GOARCH)" && \
    if [ "${arch}" != "$(go env GOHOSTARCH)" ]; then \
      echo "native build required: GOARCH=${arch} differs from GOHOSTARCH=$(go env GOHOSTARCH)" >&2; exit 1; \
    fi && \
    CGO_ENABLED=1 GOEXPERIMENT=strictfipsruntime GOTOOLCHAIN=local make build && \
    mkdir -p /output && \
    tar -czf "/output/oc-mirror-rhel9-linux-${arch}.tar.gz" -C bin oc-mirror

# Stage 3: Final delivery image for push-artifacts-to-cdn
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest
RUN mkdir -p /releases/
COPY --from=builder_rhel8 /output/ /releases/
COPY --from=builder_rhel9 /output/ /releases/

# Required EC Metadata Labels
LABEL vendor="Red Hat, Inc." \
      name="oc-mirror" \
      com.redhat.component="oc-mirror" \
      version="1.0.0" \
      release="1" \
      summary="oc-mirror CLI tool transport container" \
      description="OpenShift is a platform for developing, building, and deploying containerized applications." \
      io.k8s.display-name="oc-mirror" \
      io.openshift.tags="openshift,cli,mirror"
